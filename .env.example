# Anthropic API key — get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Cesium Ion token — free token at https://cesium.com/ion/
# Required for high-res terrain (Cesium World Terrain) and Bing Maps imagery.
CESIUM_ION_TOKEN=your-cesium-ion-token-here

# Port to run the server on (default: 3000)
PORT=3000
